          "host": "IP Address or Hostname",
          "port": "Port",
          "api_key": "API Key (optional)"
        }
      },
      "printer": {
        "title": "Connect to Snapmaker U1",
        "description": "Enter the IP address of your Snapmaker U1 printer. Leave the API key blank if your printer uses the default trusted LAN client configuration.",
