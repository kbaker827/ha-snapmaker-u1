          "host": "IP Address or Hostname",
          "port": "Port (default 80)",
          "api_key": "API Key (optional)"
        },
        "data_description": {
          "host": "The IP address or hostname of your Snapmaker U1 on your local network.",
          "api_key": "Only required if you have configured authentication in Moonraker."
        }
      },
      "popstatus": {
        "title": "Add a BIQU PopStatus",
        "description": "Enter the IP address or hostname of your PopStatus light bar (e.g. 192.168.1.60 or PopStatus.local). Set it up and connect it to your printer in BIQU's app or its own web page first.",
        "data": {
          "host": "PopStatus address",
          "printer_entry_id": "Printer"
        },
        "data_description": {
          "printer_entry_id": "The printer it belongs to; its dashboard card gets a Status bar button."
        }
      },
      "reconfigure_popstatus": {
        "title": "Reconfigure PopStatus",
        "data": {
          "host": "PopStatus address",
          "printer_entry_id": "Printer"
        }
      }
    },
